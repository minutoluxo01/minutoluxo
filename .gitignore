# Vercel (vínculo local do projeto — nunca deve ser versionado)
.vercel

# Dependências (caso o projeto passe a usar alguma no futuro)
node_modules/

# Variáveis de ambiente
.env
.env.*

# Arquivos de sistema
.DS_Store
Thumbs.db

